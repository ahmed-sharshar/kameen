# Kameen server settings.
# Copy this file to server/.env and fill in what you need. Never commit .env.
# Only ACCESS_CODE is required. Every other feature stays switched off while its keys are empty,
# and the rest of the app keeps working.

# --- Access ----------------------------------------------------------------------------------
# The code the website sends with every request. docs/config.js has DEFAULT_CODE set to this same
# value so visitors are let straight in. Change both together, or empty DEFAULT_CODE so visitors
# have to type the code.
ACCESS_CODE=a50a3a505c5f1bc17dd1569eab0c48bc
# Needed only to upload new test metrics to a running server (POST /eval).
ADMIN_CODE=change-me-admin
# Website origins allowed to call this server, comma-separated (CORS).
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# The public address of this server, used to build Telegram and email links.
# Render fills in RENDER_EXTERNAL_URL automatically, so this is only needed on other hosts.
# PUBLIC_URL=https://your-server.example.com

# --- Database ----------------------------------------------------------------------------------
# Leave unset locally: the server creates kameen.db (SQLite) in the server/ folder.
# DATABASE_URL=postgresql://user:password@host:5432/kameen

# --- AI models (Anthropic Claude API) ------------------------------------------------------------
# Leave empty to run with the scripted stand-in model: every screen works and nothing is billed.
ANTHROPIC_API_KEY=
LIVE_MODEL=claude-haiku-5-5
DIRECTOR_MODEL=claude-sonnet-5-5
PLAYBOOK_MODEL=claude-opus-5-5
# Set to 1 to use the scripted stand-in even when a key is present.
# KAMEEN_FAKE_MODEL=1

# --- Voice (ElevenLabs; optional) ----------------------------------------------------------------
ELEVENLABS_API_KEY=
# Agent IDs for the three voices: English, Indian English and Emirati Arabic.
ELEVENLABS_AGENT_EN=
ELEVENLABS_AGENT_EN_IN=
ELEVENLABS_AGENT_AR=
# For real outbound phone calls: the ElevenLabs ID of a Twilio number imported into ElevenLabs.
ELEVENLABS_PHONE_NUMBER_ID=
# Each ElevenLabs agent sends this as its Custom LLM API key.
LLM_SHARED_SECRET=change-me-to-a-long-random-string
# Set to 1 to reject every voice turn that does not carry LLM_SHARED_SECRET.
# VOICE_REQUIRE_SECRET=1

# --- Telegram (optional) ------------------------------------------------------------------------
# A bot token from @BotFather. The server points the bot's webhook at itself on start-up.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-secret

# --- Email (optional) ---------------------------------------------------------------------------
# Tried in this order: SendGrid, then Resend, then SMTP. Render's free plan blocks SMTP, so use
# SendGrid or Resend there.
SENDGRID_API_KEY=
RESEND_API_KEY=
# The address mail is sent from. It must be a sender your provider has verified.
MAIL_FROM_ADDRESS=
# SMTP fallback, for example a Gmail address with a Gmail App Password.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# --- Case notifications --------------------------------------------------------------------------
# The sender name on every notification. Never the police, a bank or any other real body.
NOTIFY_BRAND=ScamShield AI
# Where a "Fooled" case from AUTO_EMAIL_NUMBER is emailed automatically. Set both to your own
# values: when empty, the server falls back to the original project's demo address and number.
CASE_ALERT_EMAIL=
AUTO_EMAIL_NUMBER=

# --- Drills and demo data ------------------------------------------------------------------------
# Hours before the same person can be drilled again: 0 for rehearsals, 168 (one week) in production.
DRILL_COOLDOWN_HOURS=0
# Dashboard views hide groups smaller than this, so no one can be singled out.
DRILL_MIN_GROUP=5
# Bank code used in synthetic bait IBANs. Confirm it is unassigned before using it in public.
CANARY_BANK_CODE=999
# 1 loads a synthetic demo history (decoy conversations, drills, a phishing campaign and cases) once
# at start-up. Remove it again with: .venv/bin/python scripts/seed.py --clear
SEED_DEMO=
