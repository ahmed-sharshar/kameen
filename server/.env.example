# Copy this file to server/.env and fill in the values. Never commit .env.

# Leave empty to run with the scripted fake model (no API calls).
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_EN=
ELEVENLABS_AGENT_EN_IN=
ELEVENLABS_AGENT_AR=

# Leave unset locally: the server then uses a SQLite file.
# DATABASE_URL=

# Comma-separated list of allowed website origins.
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
LLM_SHARED_SECRET=change-me-to-a-long-random-string
ACCESS_CODE=kameen-local
ADMIN_CODE=change-me-admin

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

LIVE_MODEL=claude-haiku-5-5
DIRECTOR_MODEL=claude-sonnet-5-5
PLAYBOOK_MODEL=claude-opus-5-5

# 0 for rehearsals and the event, 168 (one week) in production.
DRILL_COOLDOWN_HOURS=0
# Organisation views hide groups smaller than this.
DRILL_MIN_GROUP=5
# Bank code used in synthetic IBANs. Confirm it is unassigned before the event.
CANARY_BANK_CODE=999
# "1" loads the synthetic demo history (25 past conversations, 43 drill results) once at start-up.
# Remove it again with: .venv/bin/python scripts/seed.py --clear
SEED_DEMO=
